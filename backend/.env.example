# Application Configuration
PORT=3000
NODE_ENV=production
FRONTEND_URL=https://management-task-iota.vercel.app

# Database Configuration (Neon/Postgres)
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/dbname?sslmode=require
DB_SSL=true
DB_SYNCHRONIZE=false
DB_LOGGING=false
RUN_SEED_ON_BOOT=false

# Authentication
JWT_SECRET=your_super_secure_jwt_secret_key_change_me
JWT_EXPIRATION=1d

# Throttling/Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
